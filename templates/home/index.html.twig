{% extends 'base.html.twig' %}

{% block title %}Pondeo — Comparez les agglomérations de France{% endblock %}

{% block body %}
<main class="text-stone-900">
    <section class="relative overflow-hidden bg-gradient-to-b from-sky-100 via-amber-50 to-stone-50 px-6 pt-20 sm:pt-28">
        <div class="pointer-events-none absolute -right-16 top-8 h-56 w-56 rounded-full bg-amber-300/60 blur-2xl"></div>
        <div class="relative mx-auto max-w-3xl text-center">
            <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1 text-sm font-medium text-emerald-800 shadow-sm">
                <span aria-hidden="true">🏡</span> Données publiques, lisibles
            </span>
            <h1 class="mt-6 text-5xl font-extrabold tracking-tight sm:text-7xl">
                Où <span class="bg-gradient-to-r from-emerald-600 to-lime-500 bg-clip-text text-transparent">vivre</span> en France&nbsp;?
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-lg text-stone-700">
                Comparez les agglomérations (unités urbaines) selon ce qui compte vraiment :
                emploi, revenus, prix de l'immobilier, commerces, démographie.
            </p>
            <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <a href="{{ path('app_map') }}" class="rounded-full bg-emerald-600 px-6 py-3 font-semibold text-white shadow-md shadow-emerald-600/30 transition hover:bg-emerald-700">Explorer la carte</a>
                <a href="{{ path('app_rankings') }}" class="rounded-full border border-stone-300 bg-white px-6 py-3 font-semibold text-stone-800 transition hover:border-emerald-600 hover:text-emerald-700">Voir les classements</a>
            </div>
        </div>

        <dl class="relative mx-auto mt-14 grid max-w-3xl grid-cols-3 gap-4 text-center">
            <div class="rounded-2xl bg-white/80 p-4 shadow-sm">
                <dt class="text-sm text-stone-600">Unités urbaines</dt>
                <dd class="mt-1 text-3xl font-bold text-emerald-700 sm:text-4xl">{{ stats.uniteUrbaines|fr_number }}</dd>
            </div>
            <div class="rounded-2xl bg-white/80 p-4 shadow-sm">
                <dt class="text-sm text-stone-600">Critères</dt>
                <dd class="mt-1 text-3xl font-bold text-emerald-700 sm:text-4xl">{{ stats.criteria|fr_number }}</dd>
            </div>
            <div class="rounded-2xl bg-white/80 p-4 shadow-sm">
                <dt class="text-sm text-stone-600">Habitants couverts</dt>
                <dd class="mt-1 text-3xl font-bold text-emerald-700 sm:text-4xl">{{ (stats.population / 1000000)|round(1)|fr_number }}&nbsp;M</dd>
            </div>
        </dl>

        <svg viewBox="0 0 1440 160" preserveAspectRatio="none" class="relative mt-10 block h-24 w-full sm:h-40" aria-hidden="true">
            <path d="M0 90 C240 20 420 20 640 80 S1080 150 1440 50 V160 H0Z" fill="#a7f3d0"/>
            <path d="M0 120 C300 60 520 70 760 110 S1180 160 1440 100 V160 H0Z" fill="#6ee7b7"/>
            <path d="M0 150 C360 110 640 120 900 140 S1300 160 1440 135 V160 H0Z" fill="#fafaf9"/>
        </svg>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
        <div class="flex items-end justify-between gap-4">
            <h2 class="text-3xl font-bold tracking-tight">Classements à la une</h2>
            <a href="{{ path('app_rankings') }}" class="text-sm font-medium text-emerald-700 hover:underline">Tous les classements →</a>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {% for podium in podiums %}
                {{ include('ranking/_podium.html.twig', {podium: podium}) }}
            {% endfor %}
        </div>
    </section>

    <section class="bg-emerald-50 px-6 py-20">
        <div class="mx-auto max-w-5xl">
            <h2 class="text-center text-3xl font-bold tracking-tight">Comment ça marche</h2>
            <ol class="mt-12 grid gap-8 sm:grid-cols-3">
                <li>
                    <span class="text-4xl font-extrabold text-emerald-600">1</span>
                    <h3 class="mt-2 font-semibold">Des données ouvertes</h3>
                    <p class="mt-1 text-sm text-stone-600">Insee, impôts, transactions immobilières : des sources publiques, rassemblées au même endroit.</p>
                </li>
                <li>
                    <span class="text-4xl font-extrabold text-emerald-600">2</span>
                    <h3 class="mt-2 font-semibold">Une échelle comparable</h3>
                    <p class="mt-1 text-sm text-stone-600">Tout est ramené à l'unité urbaine, l'agglomération telle qu'on la vit, au-delà des limites communales.</p>
                </li>
                <li>
                    <span class="text-4xl font-extrabold text-emerald-600">3</span>
                    <h3 class="mt-2 font-semibold">À vous de comparer</h3>
                    <p class="mt-1 text-sm text-stone-600">Filtrez sur la carte, parcourez les classements ou ouvrez la fiche d'une ville.</p>
                </li>
            </ol>
        </div>
    </section>
</main>
{% endblock %}
