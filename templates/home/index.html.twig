{% extends 'base.html.twig' %}

{% block title %}Pondeo — Bientôt disponible{% endblock %}

{% block body %}
<main class="flex min-h-screen items-center justify-center bg-gradient-to-br from-slate-950 via-slate-900 to-emerald-950 px-6 py-16 text-slate-100">
    <div class="w-full max-w-2xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-4 py-1 text-sm font-medium text-emerald-300">
            Bientôt disponible
        </span>

        <h1 class="mt-6 text-5xl font-bold tracking-tight sm:text-6xl">
            Pondeo
        </h1>

        <p class="mx-auto mt-6 max-w-xl text-lg text-slate-300">
            Comparez les communes, départements, régions et intercommunalités
            de France selon les critères qui comptent vraiment pour vous.
        </p>

        <ul class="mx-auto mt-10 grid max-w-lg grid-cols-1 gap-3 text-left sm:grid-cols-3 sm:text-center">
            <li class="rounded-lg border border-slate-700/50 bg-slate-800/40 p-4 text-sm text-slate-300">
                Démographie
            </li>
            <li class="rounded-lg border border-slate-700/50 bg-slate-800/40 p-4 text-sm text-slate-300">
                Commerces &amp; services à proximité
            </li>
            <li class="rounded-lg border border-slate-700/50 bg-slate-800/40 p-4 text-sm text-slate-300">
                Climat
            </li>
        </ul>
    </div>
</main>
{% endblock %}
