{% extends 'base.html.twig' %}

{% block title %}Les critères — Pondeo{% endblock %}

{% block meta_description %}Tout ce que Pondeo mesure sur chaque agglomération, expliqué simplement : ce que veut dire chaque critère, ses limites et d'où viennent les données.{% endblock %}

{% block body %}
<main class="min-h-[calc(100vh-3.5rem)] bg-transparent px-6 py-12 text-stone-900">
    <div class="mx-auto max-w-4xl">
        <h1 class="text-4xl font-bold tracking-tight">Les critères</h1>
        <p class="mt-3 max-w-2xl text-stone-600">
            Tout ce que Pondeo mesure sur chaque agglomération, et ce que cela veut dire.
        </p>

        <nav aria-label="Sommaire" class="mt-6">
            <ul class="flex flex-wrap gap-2">
                {% for group in groups %}
                    <li><a href="#{{ group.slug }}" class="rounded-full border border-stone-300 px-3 py-1 text-sm text-stone-700 hover:border-emerald-600 hover:text-emerald-700">{{ group.label }}</a></li>
                {% endfor %}
            </ul>
        </nav>

        {% for group in groups %}
            <section id="{{ group.slug }}" class="mt-12 scroll-mt-20">
                <h2 class="text-xl font-semibold text-stone-800">{{ group.label }}</h2>
                <dl class="mt-4 divide-y divide-stone-200 border-y border-stone-200">
                    {% for entry in group.criteria %}
                        {% set criterion = entry.criterion %}
                        <div class="py-4">
                            <dt class="flex flex-wrap items-baseline gap-x-3 font-medium text-stone-900">
                                {{ criterion.label }}
                                {% if criterion.unit %}<span class="text-xs font-normal text-stone-500">{{ criterion.unit }}</span>{% endif %}
                                {% if entry.ranked %}
                                    <a href="{{ path('app_ranking', {code: criterion.code}) }}" class="text-xs font-normal text-emerald-700 hover:underline">Voir le classement →</a>
                                {% endif %}
                            </dt>
                            {% if entry.description %}
                                <dd class="mt-1 space-y-2 text-sm leading-relaxed text-stone-600">
                                    {% for paragraph in entry.description|split('\n\n') %}<p>{{ paragraph }}</p>{% endfor %}
                                </dd>
                            {% endif %}
                            {% if entry.source %}
                                <dd class="mt-1 text-xs text-stone-500">Source : {{ entry.source }}.</dd>
                            {% endif %}
                        </div>
                    {% endfor %}
                </dl>
            </section>
        {% endfor %}
    </div>
</main>
{% endblock %}
