{% extends 'base.html.twig' %}

{% block title %}Pondeo — {{ title }}{% endblock %}

{% block meta_description %}La carte des agglomérations de France : filtrez par population, prix de l'immobilier, commerces, gares ou distance aux centrales nucléaires.{% endblock %}

{# The map fills the viewport: no room for a footer. #}
{% block footer %}{% endblock %}

{% block body %}
<div class="relative flex h-[calc(100dvh-3.5rem)] bg-transparent text-stone-900"
     data-controller="map"
     data-map-data-url-value="{{ dataUrl }}"
     data-map-plants-url-value="{{ plantsUrl }}"
     data-map-export-url-value="{{ exportUrl }}"
     data-map-export-limit-value="{{ exportLimit }}"
     data-map-detail-url-value="{{ path('app_unite_urbaine_detail', {code: 'XXXXX'}) }}"
     data-map-population-min-value="{{ populationMin }}"
     data-map-population-max-value="{{ populationMax }}"
     data-map-stats-value="{{ stats|json_encode|e('html_attr') }}"
>
    {# Below md the filters are a drawer over the map, opened from this button. #}
    <button type="button" data-action="map#openFilters" data-map-target="filtersButton"
            class="absolute bottom-6 left-1/2 z-10 -translate-x-1/2 rounded-full bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-lg md:hidden">
        Filtres
    </button>

    <aside class="fixed inset-x-0 bottom-0 top-14 z-20 hidden overflow-y-auto border-stone-200 bg-white p-6 md:static md:block md:w-80 md:shrink-0 md:border-r lg:w-96 xl:w-[28rem]" data-map-target="filters">
        <button type="button" data-action="map#closeFilters"
                class="mb-6 w-full rounded bg-emerald-600 px-4 py-2 text-sm font-semibold text-white md:hidden">
            Voir la carte
        </button>

        <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-600">Population</h2>

        <div class="relative mt-6 h-1 rounded bg-stone-300">
            <input type="range" data-map-target="minRange"
                   min="0" max="0" step="1" value="0"
                   data-action="input->map#onRangeInput"
                   class="pointer-events-none absolute inset-x-0 top-1/2 h-1 w-full -translate-y-1/2 appearance-none bg-transparent [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-emerald-500 [&::-moz-range-thumb]:pointer-events-auto [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:appearance-none [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:bg-emerald-500">
            <input type="range" data-map-target="maxRange"
                   min="0" max="0" step="1" value="0"
                   data-action="input->map#onRangeInput"
                   class="pointer-events-none absolute inset-x-0 top-1/2 h-1 w-full -translate-y-1/2 appearance-none bg-transparent [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-emerald-500 [&::-moz-range-thumb]:pointer-events-auto [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:appearance-none [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:bg-emerald-500">
        </div>

        <div class="mt-4 flex items-center gap-2 text-sm text-stone-700">
            <input type="number" inputmode="numeric" step="1" aria-label="Population minimale"
                   min="{{ populationMin }}" max="{{ populationMax }}" value="{{ populationMin }}"
                   data-map-target="minInput"
                   data-action="input->map#onNumberInput change->map#onNumberChange"
                   class="w-full rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
            <span aria-hidden="true">–</span>
            <input type="number" inputmode="numeric" step="1" aria-label="Population maximale"
                   min="{{ populationMin }}" max="{{ populationMax }}" value="{{ populationMax }}"
                   data-map-target="maxInput"
                   data-action="input->map#onNumberInput change->map#onNumberChange"
                   class="w-full rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
        </div>

        <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-stone-600">Aires d'attraction</h2>

        <label class="mt-4 flex cursor-pointer items-start gap-3 text-sm text-stone-700">
            <input type="checkbox" data-map-target="excludeCouronne" data-action="change->map#onToggleChange"
                   class="mt-0.5 h-4 w-4 shrink-0 accent-emerald-600">
            <span>Exclure les villes de la couronne d'une autre
                <span class="block text-xs text-stone-500">Arradon, qui dépend de Vannes, par exemple</span>
            </span>
        </label>

        <label class="mt-4 flex cursor-pointer items-start gap-3 text-sm text-stone-700">
            <input type="checkbox" data-map-target="excludePolesSecondaires" data-action="change->map#onToggleChange"
                   class="mt-0.5 h-4 w-4 shrink-0 accent-emerald-600">
            <span>Exclure les pôles secondaires
                <span class="block text-xs text-stone-500">Villes qui forment un pôle d'emploi dans l'aire d'une plus grande</span>
            </span>
        </label>

        <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-stone-600">Gares et trains</h2>

        <div class="mt-4 flex items-center gap-2 text-sm text-stone-700">
            <select aria-label="Ville de destination, trajet 1" data-map-target="trainCity" data-action="change->map#onTrainInput"
                    class="w-full rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
                <option value="">—</option>
                {% for destination in journeyDestinations %}
                    <option value="{{ destination.value }}">{{ destination.label }}</option>
                {% endfor %}
            </select>
            <span class="shrink-0">à moins de</span>
            <input type="number" inputmode="decimal" step="0.5" min="0" placeholder="∞"
                   aria-label="Durée maximale du trajet 1, en heures"
                   data-map-target="trainHours" data-action="input->map#onTrainInput"
                   class="w-16 shrink-0 rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
            <span>h</span>
        </div>

        <div class="mt-4 flex items-center gap-2 text-sm text-stone-700">
            <select aria-label="Ville de destination, trajet 2" data-map-target="trainCity" data-action="change->map#onTrainInput"
                    class="w-full rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
                <option value="">—</option>
                {% for destination in journeyDestinations %}
                    <option value="{{ destination.value }}">{{ destination.label }}</option>
                {% endfor %}
            </select>
            <span class="shrink-0">à moins de</span>
            <input type="number" inputmode="decimal" step="0.5" min="0" placeholder="∞"
                   aria-label="Durée maximale du trajet 2, en heures"
                   data-map-target="trainHours" data-action="input->map#onTrainInput"
                   class="w-16 shrink-0 rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
            <span>h</span>
        </div>

        <p class="mt-2 text-xs text-stone-500">Voiture jusqu'à la gare la plus pratique, puis train (durée médiane un jour de semaine). Temps de voiture théoriques, sans trafic.</p>

        <label class="mt-4 block text-sm text-stone-700">
            Exclure les trajets à plus de
            <span class="mt-2 flex items-center gap-2">
                <input type="number" inputmode="numeric" step="1" min="0" placeholder="∞"
                       aria-label="Nombre maximum de changements"
                       data-map-target="trainMaxTransfers"
                       data-action="input->map#onTrainInput"
                       class="w-16 rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
                <span>changements</span>
            </span>
            <span class="mt-1 block text-xs text-stone-500">0 pour un train direct ; s'applique aux villes choisies ci-dessus</span>
        </label>

        <label class="mt-4 flex cursor-pointer items-start gap-3 text-sm text-stone-700">
            <input type="checkbox" data-map-target="withStation" data-action="change->map#onToggleChange"
                   class="mt-0.5 h-4 w-4 shrink-0 accent-emerald-600">
            <span>Exclure les villes sans gare
                <span class="block text-xs text-stone-500">Au moins une gare voyageurs dans l'agglomération</span>
            </span>
        </label>

        <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-stone-600">Commerces</h2>

        <label class="mt-4 block text-sm text-stone-700">
            Au moins
            <span class="mt-2 flex items-center gap-2">
                <input type="number" inputmode="decimal" step="0.5" min="0" placeholder="0"
                       aria-label="Commerces minimum pour 1000 habitants"
                       data-map-target="commerceDensityMin"
                       data-action="input->map#onCommerceInput"
                       class="w-24 rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
                <span>commerces pour 1000 hab.</span>
            </span>
            <span class="mt-1 block text-xs text-stone-500">Tous commerces confondus (INSEE, BPE)</span>
        </label>
        {{ include('map/_stats_hint.html.twig', {code: 'commerces_total_pour_1000_hab', input: 'commerceDensityMin', direction: 'min', unit: 'commerces pour 1000 hab.', decimals: 1}) }}

        <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-stone-600">Restaurants</h2>

        <label class="mt-4 block text-sm text-stone-700">
            Au moins
            <span class="mt-2 flex items-center gap-2">
                <input type="number" inputmode="decimal" step="0.5" min="0" placeholder="0"
                       aria-label="Restaurants minimum pour 1000 habitants"
                       data-map-target="restaurantDensityMin"
                       data-action="input->map#onRestaurantInput"
                       class="w-24 rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
                <span>restaurants pour 1000 hab.</span>
            </span>
            <span class="mt-1 block text-xs text-stone-500">Restauration traditionnelle et rapide (INSEE, BPE)</span>
        </label>
        {{ include('map/_stats_hint.html.twig', {code: 'restaurants_pour_1000_hab', input: 'restaurantDensityMin', direction: 'min', unit: 'restaurants pour 1000 hab.', decimals: 1}) }}

        <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-stone-600">Immobilier</h2>

        <div class="mt-4 flex overflow-hidden rounded border border-stone-300 text-sm" role="group" aria-label="Type de bien">
            {% for type, label in {global: 'Global', house: 'Maisons', apartment: 'Appartements'} %}
                <button type="button" data-map-target="priceTypeButton" data-price-type="{{ type }}"
                        data-action="map#onPriceTypeClick" aria-pressed="{{ 'global' == type ? 'true' : 'false' }}"
                        class="flex-1 px-2 py-1 text-stone-700 aria-pressed:bg-emerald-600 aria-pressed:text-white">{{ label }}</button>
            {% endfor %}
        </div>

        <label class="mt-4 block text-sm text-stone-700">
            Au plus
            <span class="mt-2 flex items-center gap-2">
                <input type="number" inputmode="numeric" step="100" min="0" placeholder="∞"
                       aria-label="Prix maximum au mètre carré, en euros"
                       data-map-target="priceMax"
                       data-action="input->map#onPriceInput"
                       class="w-24 rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
                <span>€/m²</span>
            </span>
            <span class="mt-1 block text-xs text-stone-500" data-map-target="priceHelp">Appartements et maisons, dernière année (DVF)</span>
        </label>
        {{ include('map/_stats_hint.html.twig', {input: 'priceMax', direction: 'max', unit: '€/m²', decimals: -2}) }}

        <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-stone-600">Centrales nucléaires</h2>

        <label class="mt-4 block text-sm text-stone-700">
            Écarter les villes à moins de
            <span class="mt-2 flex items-center gap-2">
                <input type="number" inputmode="decimal" step="5" min="0" placeholder="0"
                       aria-label="Distance minimale à une centrale nucléaire, en kilomètres"
                       data-map-target="nuclearExclusionKm"
                       data-action="input->map#onNuclearInput"
                       class="w-24 rounded border border-stone-300 bg-white px-2 py-1 text-stone-900 focus:border-emerald-600 focus:outline-none">
                <span>km d'une centrale</span>
            </span>
            <span class="mt-1 block text-xs text-stone-500">Distance mesurée depuis le centre de la ville ; le rayon est tracé sur la carte</span>
        </label>

        <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-stone-600">Loisirs</h2>

        <label class="mt-4 flex cursor-pointer items-start gap-3 text-sm text-stone-700">
            <input type="checkbox" data-map-target="withBoardGameAssociation" data-action="change->map#onToggleChange"
                   class="mt-0.5 h-4 w-4 shrink-0 accent-emerald-600">
            <span>Exclure les villes sans association de jeux
                <span class="block text-xs text-stone-500">Au moins un club, une ludothèque ou une association de jeux de société dans l'agglomération</span>
            </span>
        </label>

        <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-stone-600">Export</h2>

        <button type="button" data-map-target="exportButton" data-action="map#exportCsv" disabled
                class="mt-4 w-full rounded bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 disabled:cursor-not-allowed disabled:bg-stone-300 disabled:text-stone-500">
            Exporter en CSV
        </button>
        <p class="mt-2 text-xs text-stone-500" data-map-target="exportHelp"></p>
    </aside>

    <div class="relative flex-1" data-map-target="mapContainer"></div>

    <aside class="group/panel fixed inset-x-0 bottom-0 top-14 z-20 hidden overflow-y-auto border-l md:relative md:inset-auto md:z-auto md:w-[26rem] md:shrink-0 border-stone-200 bg-stone-50 p-6" data-map-target="panel">
        {# Turbo marks the frame aria-busy while the city loads. #}
        <div role="status" aria-label="Chargement de la ville"
             class="pointer-events-none absolute left-1/2 top-32 z-10 hidden -translate-x-1/2 group-has-[turbo-frame[aria-busy=true]]/panel:block">
            <div class="h-10 w-10 animate-spin rounded-full border-4 border-stone-300 border-t-emerald-600"></div>
        </div>
        <button type="button" data-action="map#closePanel" aria-label="Fermer le détail"
                class="absolute right-4 top-4 text-stone-600 hover:text-stone-900">✕</button>
        <turbo-frame id="unite-urbaine-detail" class="block transition-opacity aria-busy:opacity-50" data-map-target="frame"></turbo-frame>
    </aside>
</div>
{% endblock %}
