{% extends 'base.html.twig' %}

{% block title %}Toutes les unités urbaines — Pondeo{% endblock %}

{% block meta_description %}La liste de toutes les agglomérations (unités urbaines) de France, classées par département.{% endblock %}

{% block body %}
<main class="min-h-[calc(100vh-3.5rem)] bg-transparent px-6 py-12 text-stone-900">
    <div class="mx-auto max-w-6xl">
        <h1 class="text-4xl font-bold tracking-tight">Unités urbaines</h1>
        <p class="mt-3 max-w-2xl text-stone-600">
            Toutes les agglomérations, classées par département.
        </p>

        {% for group in groups %}
            <section class="mt-10">
                <h2 class="text-xl font-semibold text-stone-800">
                    {% if group.departement %}{{ group.departement.value }} · {{ group.departement.label }}{% else %}Sans département{% endif %}
                </h2>
                <ul class="mt-3 grid gap-x-6 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
                    {% for unite in group.unites %}
                        <li>
                            <a href="{{ path('app_unite_urbaine_detail', {code: unite.code}) }}" class="text-emerald-800 hover:underline">{{ unite.name }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endfor %}
    </div>
</main>
{% endblock %}
