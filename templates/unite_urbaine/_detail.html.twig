<header>
    <h1 class="text-2xl font-semibold">Unité urbaine de {{ uniteUrbaine.name }}</h1>
    {% if uniteUrbaine.departement %}
        <p class="mt-1 text-sm text-slate-400">{{ uniteUrbaine.departement.label }} · {{ uniteUrbaine.departement.region.label }}</p>
    {% endif %}

    {% if uniteUrbaine.attractionCategory %}
        <p class="mt-1 text-sm text-slate-400">
            {% if uniteUrbaine.attractionAreaName %}
                {{ uniteUrbaine.attractionCategory.label }} · aire d'attraction de {{ uniteUrbaine.attractionAreaName }}
            {% else %}
                {{ uniteUrbaine.attractionCategory.label }}
            {% endif %}
        </p>
    {% endif %}

    {% if population %}
        <p class="mt-4 text-3xl font-semibold text-emerald-400">
            {{ population.value|criterion_value }}<span class="ml-2 text-base font-normal text-slate-400">{{ population.unit }}</span>
        </p>
        {% if population.rank %}
            <p class="mt-1 text-sm text-slate-300">
                {{ include('unite_urbaine/_rank.html.twig', {criterion: population}) }}
            </p>
        {% endif %}
    {% endif %}

    {% if inFrame %}
        <a href="{{ path('app_unite_urbaine_detail', {code: uniteUrbaine.code}) }}" data-turbo-frame="_top"
           class="mt-4 inline-block text-sm text-emerald-400 hover:underline">Voir la fiche complète →</a>
    {% endif %}
</header>

<div data-controller="criteria-filter">
{% if groups %}
    <input type="search" placeholder="Filtrer les critères" aria-label="Filtrer les critères"
           data-criteria-filter-target="input" data-action="input->criteria-filter#filter"
           class="mt-8 w-full rounded border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-emerald-400 focus:outline-none">
{% endif %}
{% for group in groups %}
    <details open class="mt-6 border-t border-slate-800 pt-4" data-criteria-filter-target="group">
        <summary class="cursor-pointer text-sm font-semibold uppercase tracking-wide text-slate-400">{{ group.label }}{% if group.commonPeriod %} <span class="ml-1 text-xs font-normal normal-case tracking-normal text-slate-500">({{ group.commonPeriod }})</span>{% endif %}</summary>
        <dl class="mt-2 divide-y divide-slate-800/60">
            {% for criterion in group.criteria %}
                {% set expandable = criterion.series|length >= 2 %}
                <div data-criteria-filter-target="row" data-label="{{ criterion.label }}"
                     {% if expandable %}data-controller="criterion-chart" data-criterion-chart-url-value="{{ path('app_unite_urbaine_criterion_series', {code: uniteUrbaine.code, criterion: criterion.code}) }}"{% endif %}>
                <div class="flex items-center justify-between gap-4 py-3{% if expandable %} cursor-pointer rounded hover:bg-slate-900/60{% endif %}"
                     {% if expandable %}role="button" tabindex="0" aria-expanded="false" aria-label="Courbe de {{ criterion.label }}" data-criterion-chart-target="header" data-action="click->criterion-chart#toggle keydown.enter->criterion-chart#toggle keydown.space->criterion-chart#toggle"{% endif %}>
                    <div class="min-w-0">
                        <dt class="text-sm text-slate-300">
                            {{ criterion.label }}{% if criterion.count is not null %} ({{ criterion.count|fr_number }}){% endif %}
                            {% if not group.commonPeriod %}<span class="ml-1 text-xs font-normal text-slate-500">({{ criterion.period }})</span>{% endif %}
                        </dt>
                        {% if criterion.rank %}
                            <dd class="mt-1 text-xs text-slate-500"><span class="text-emerald-400">{{ criterion.rank }}{{ 1 == criterion.rank ? 'er' : 'e' }}</span> sur {{ criterion.total|fr_number }}</dd>
                        {% endif %}
                    </div>
                    <div class="flex shrink-0 items-center gap-3">
                        <span class="text-right">
                            <span class="block text-sm font-medium text-slate-100">
                                {{ criterion.value|criterion_value }}
                                {% if criterion.unit %}<span class="text-slate-500">{{ criterion.unit }}</span>{% endif %}
                            </span>
                            {% if criterion.median is not null %}
                                <span class="block text-xs text-emerald-400">médiane {{ criterion.median|fr_number }}</span>
                            {% endif %}
                        </span>
                        {% if expandable %}<span aria-hidden="true" class="text-slate-500 transition-transform" data-criterion-chart-target="chevron">▾</span>{% endif %}
                    </div>
                </div>
                {% if expandable %}
                    <div hidden class="pb-4" data-criterion-chart-target="panel">
                        <div class="mb-2 flex items-center justify-end">
                            <button type="button" hidden aria-pressed="false" data-criterion-chart-target="indexButton" data-action="criterion-chart#toggleIndex"
                                    title="Ramène les deux courbes à 100 à la première année commune, pour comparer les évolutions plutôt que les niveaux"
                                    class="rounded border border-slate-700 px-2 py-1 text-xs text-slate-300 hover:border-emerald-400 aria-pressed:border-emerald-400 aria-pressed:text-emerald-400">Base 100</button>
                        </div>
                        <div class="text-slate-300" data-criterion-chart-target="chart"></div>
                        <p class="text-xs text-slate-500" data-criterion-chart-target="status" aria-live="polite"></p>
                    </div>
                {% endif %}
                </div>
            {% endfor %}
        </dl>
    </details>
{% endfor %}
</div>

{% if agePyramid %}
    <details open class="mt-8 border-t border-slate-800 pt-4">
        <summary class="cursor-pointer text-sm font-semibold uppercase tracking-wide text-slate-400">Pyramide des âges <span class="ml-1 text-xs font-normal normal-case tracking-normal text-slate-500">({{ agePyramid.year }})</span></summary>
        <div class="mt-3 flex justify-between text-xs">
            <span class="text-sky-400">Hommes · {{ agePyramid.menShare|fr_number }} %</span>
            <span class="text-pink-400">Femmes · {{ agePyramid.womenShare|fr_number }} %</span>
        </div>
        <svg viewBox="0 0 {{ constant('App\\Service\\Detail\\AgePyramid::WIDTH') }} {{ agePyramid.height }}" class="mx-auto mt-1 w-full max-w-xl" role="img"
             aria-label="Pyramide des âges de {{ agePyramid.total|fr_number }} habitants, par tranche de 5 ans">
            {% for tick in agePyramid.ticks %}
                <line x1="{{ tick.menX }}" x2="{{ tick.menX }}" y1="0" y2="{{ agePyramid.plotBottom }}" class="stroke-slate-800" stroke-width="1"/>
                <line x1="{{ tick.womenX }}" x2="{{ tick.womenX }}" y1="0" y2="{{ agePyramid.plotBottom }}" class="stroke-slate-800" stroke-width="1"/>
                <text x="{{ tick.menX }}" y="{{ agePyramid.height - 6 }}" text-anchor="middle" class="fill-slate-500 text-[11px]">{{ tick.value|fr_number }}</text>
                <text x="{{ tick.womenX }}" y="{{ agePyramid.height - 6 }}" text-anchor="middle" class="fill-slate-500 text-[11px]">{{ tick.value|fr_number }}</text>
            {% endfor %}
            {% for bracket in agePyramid.brackets %}
                <rect x="{{ bracket.menX }}" y="{{ bracket.y }}" width="{{ bracket.menWidth }}" height="{{ constant('App\\Service\\Detail\\AgePyramid::ROW_HEIGHT') - 1 }}" class="fill-sky-400 hover:fill-sky-300"><title>{{ bracket.label }} ans : {{ bracket.men|fr_number }} hommes</title></rect>
                <rect x="{{ agePyramid.womenStart }}" y="{{ bracket.y }}" width="{{ bracket.womenWidth }}" height="{{ constant('App\\Service\\Detail\\AgePyramid::ROW_HEIGHT') - 1 }}" class="fill-pink-400 hover:fill-pink-300"><title>{{ bracket.label }} ans : {{ bracket.women|fr_number }} femmes</title></rect>
                <text x="{{ agePyramid.labelX }}" y="{{ bracket.y + 11 }}" text-anchor="middle" class="fill-slate-300 text-[11px]">{{ bracket.label }}</text>
            {% endfor %}
        </svg>
        <p class="text-center text-xs text-slate-500">Habitants par tranche de 5 ans</p>
        <details class="mt-4">
            <summary class="cursor-pointer text-xs text-slate-400 hover:text-slate-200">Détail par tranche d'âge</summary>
            <table class="mt-2 w-full text-right text-sm tabular-nums">
                <thead class="text-xs text-slate-500">
                    <tr>
                        <th scope="col" class="py-1 text-left font-normal">Âge</th>
                        <th scope="col" class="py-1 font-normal text-sky-400">Hommes</th>
                        <th scope="col" class="py-1 font-normal text-pink-400">Femmes</th>
                        <th scope="col" class="py-1 font-normal">Total</th>
                        <th scope="col" class="py-1 font-normal">Part</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60 text-slate-300">
                    {% for bracket in agePyramid.brackets|reverse %}
                        <tr>
                            <th scope="row" class="py-1 text-left font-normal text-slate-400">{{ bracket.label }} ans</th>
                            <td class="py-1">{{ bracket.men|fr_number }}</td>
                            <td class="py-1">{{ bracket.women|fr_number }}</td>
                            <td class="py-1 text-slate-100">{{ (bracket.men + bracket.women)|fr_number }}</td>
                            <td class="py-1 text-slate-500">{{ bracket.share|fr_number }} %</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot class="border-t border-slate-700 font-medium text-slate-100">
                    <tr>
                        <th scope="row" class="py-1 text-left font-medium">Total</th>
                        <td class="py-1">{{ agePyramid.menTotal|fr_number }}</td>
                        <td class="py-1">{{ agePyramid.womenTotal|fr_number }}</td>
                        <td class="py-1">{{ agePyramid.total|fr_number }}</td>
                        <td class="py-1">100 %</td>
                    </tr>
                </tfoot>
            </table>
        </details>
    </details>
{% endif %}

{% if poiCategories %}
    <details open class="mt-8 border-t border-slate-800 pt-4">
        <summary class="cursor-pointer text-sm font-semibold uppercase tracking-wide text-slate-400">Points d'intérêt</summary>
        {% for category in poiCategories %}
            <h3 class="mt-4 text-sm text-slate-300">{{ category.label }} <span class="text-slate-500">({{ category.total }})</span></h3>
            <ul class="mt-1 divide-y divide-slate-800/60 text-sm">
                {% for poi in category.pois %}
                    <li class="py-2">
                        <span class="text-slate-100">{{ poi.name }}</span>
                        {% if poi.brand %}<span class="text-slate-500"> · {{ poi.brand }}</span>{% endif %}
                        {% if poi.address %}<div class="text-xs text-slate-500">{{ poi.address }}</div>{% endif %}
                    </li>
                {% endfor %}
            </ul>
            {% if category.total > category.pois|length %}
                <p class="mt-1 text-xs text-slate-500">et {{ category.total - category.pois|length }} autres</p>
            {% endif %}
        {% endfor %}
    </details>
{% endif %}

<details class="mt-8 border-t border-slate-800 pt-4">
    <summary class="cursor-pointer text-sm font-semibold uppercase tracking-wide text-slate-400">Communes ({{ uniteUrbaine.communes|length }})</summary>
    <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-slate-300">
        {% for commune in uniteUrbaine.communes %}
            <li>{{ commune.name }}</li>
        {% endfor %}
    </ul>
</details>
