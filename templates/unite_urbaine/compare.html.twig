{% extends 'base.html.twig' %}

{% block title %}Comparer des villes — Pondeo{% endblock %}

{% block meta_description %}Comparez côte à côte jusqu'à quatre agglomérations françaises sur l'ensemble des critères de Pondeo.{% endblock %}

{% block body %}
{% set codes = unites|map(u => u.code) %}
<main class="min-h-[calc(100vh-3.5rem)] bg-transparent px-6 py-12 text-stone-900">
    <div class="mx-auto max-w-6xl">
        <h1 class="text-4xl font-bold tracking-tight">Comparer des villes</h1>
        <p class="mt-3 max-w-2xl text-stone-600">Choisissez de 2 à {{ maxCities }} unités urbaines pour les comparer critère par critère.</p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
            {% for unite in unites %}
                <span class="inline-flex items-center gap-2 rounded-full border border-emerald-600 bg-emerald-50 px-3 py-1 text-sm text-emerald-800">
                    {{ unite.name }}
                    <a href="{{ path('app_compare', {villes: codes|filter(c => c != unite.code)|join(',')}) }}" aria-label="Retirer {{ unite.name }}" class="hover:text-emerald-950">×</a>
                </span>
            {% endfor %}

            {% if unites|length < maxCities %}
                <div class="relative w-64"
                     data-controller="search"
                     data-search-index-url-value="{{ path('app_search_index') }}"
                     data-search-detail-url-value="{{ path('app_compare', {villes: (codes|merge(['XXXXX']))|join(',')}) }}">
                    <input type="search" placeholder="Ajouter une ville…" autocomplete="off" aria-label="Ajouter une unité urbaine à la comparaison"
                           role="combobox" aria-expanded="false" aria-controls="compare-search-results"
                           data-search-target="input"
                           data-action="focus->search#load input->search#search keydown->search#keydown blur->search#blur"
                           class="w-full rounded-full border border-stone-300 bg-white px-4 py-1.5 text-sm text-stone-900 placeholder:text-stone-400 focus:border-emerald-600 focus:outline-none">
                    <ul id="compare-search-results" role="listbox" hidden data-search-target="results"
                        class="absolute left-0 top-full z-40 mt-1 w-full overflow-hidden rounded-xl border border-stone-200 bg-white text-sm shadow-lg"></ul>
                </div>
            {% endif %}
        </div>

        {% if unites|length < 2 %}
            <p class="mt-10 text-stone-600">Ajoutez au moins deux villes pour afficher la comparaison.</p>
        {% else %}
            <div class="mt-8 overflow-x-auto">
                <table class="w-full min-w-[32rem] border-collapse text-sm">
                    <thead class="sticky top-14 bg-stone-50">
                        <tr>
                            <th scope="col" class="py-2 pr-4 text-left font-medium text-stone-500">Critère</th>
                            {% for unite in unites %}
                                <th scope="col" class="px-3 py-2 text-right">
                                    <a href="{{ path('app_unite_urbaine_detail', {code: unite.code}) }}" class="font-semibold text-emerald-800 hover:underline">{{ unite.name }}</a>
                                    {% if unite.departement %}<span class="block text-xs font-normal text-stone-500">{{ unite.departement.label }}</span>{% endif %}
                                </th>
                            {% endfor %}
                        </tr>
                    </thead>
                    {% for group in groups %}
                        <tbody>
                            <tr><th colspan="{{ unites|length + 1 }}" scope="colgroup" class="border-b border-stone-200 pb-2 pt-8 text-left text-sm font-semibold uppercase tracking-wide text-stone-600">{{ group.label }}</th></tr>
                            {% for row in group.rows %}
                                <tr class="border-b border-stone-100">
                                    <th scope="row" class="py-2 pr-4 text-left font-normal text-stone-700">{{ row.label }}</th>
                                    {% for cell in row.cells %}
                                        <td class="px-3 py-2 text-right tabular-nums {{ loop.index0 in row.best ? 'font-semibold text-emerald-700' : 'text-stone-900' }}">
                                            {% if cell is null %}
                                                <span class="text-stone-400">—</span>
                                            {% else %}
                                                {% if cell.trend %}{{ include('unite_urbaine/_trend.html.twig', {trend: cell.trend, until: cell.period}) }}{% endif %}
                                                {{ cell.value|criterion_value }}{% if cell.unit %}<span class="ml-1 text-xs font-normal text-stone-500">{{ cell.unit }}</span>{% endif %}
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    {% endfor %}
                </table>
            </div>
        {% endif %}
    </div>
</main>
{% endblock %}
