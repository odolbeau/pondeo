<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Pondeo — Comparez les agglomérations de France{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Comparez les agglomérations de France : emploi, revenus, immobilier, commerces, climat et risques, sur des données publiques.{% endblock %}">
        <link rel="canonical" href="{{ absolute_url(app.request.pathInfo) }}">
        <meta property="og:site_name" content="Pondeo">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:type" content="website">
        <meta property="og:title" content="{{ block('title')|striptags }}">
        <meta property="og:description" content="{{ block('meta_description')|striptags }}">
        <meta property="og:url" content="{{ absolute_url(app.request.pathInfo) }}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221em%22 font-size=%2290%22>🌳</text></svg>">
        {% block stylesheets %}
            {{ reprise_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ reprise_entry_script_tags('app') }}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="bg-stone-50 font-sans text-stone-900 antialiased">
        {% block navigation %}{{ include('_nav.html.twig') }}{% endblock %}
        {% block body %}{% endblock %}
        {% block footer %}{{ include('_footer.html.twig') }}{% endblock %}
    </body>
</html>
