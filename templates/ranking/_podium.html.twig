<a href="{{ path('app_ranking', {code: podium.ranking.code}) }}"
   class="group flex h-full flex-col rounded-3xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-emerald-300 hover:shadow-md">
    <p class="text-xs font-medium uppercase tracking-wider text-emerald-700">{{ podium.ranking.theme }}</p>
    <h3 class="mt-1 text-lg font-semibold text-stone-900">{{ podium.ranking.title }}</h3>
    <p class="mt-1 text-sm text-stone-600">{{ podium.ranking.tagline }}</p>

    {% if podium.rows %}
        <ol class="mt-4 space-y-2 text-sm">
            {% for row in podium.rows %}
                <li class="flex items-baseline gap-3">
                    <span class="w-5 shrink-0 font-semibold text-emerald-700">{{ row.rank }}</span>
                    <span class="min-w-0 flex-1 truncate text-stone-800">{{ row.name }}</span>
                    <span class="shrink-0 tabular-nums text-stone-600">{{ row.value|criterion_value }}{% if podium.criterion.unit %}&nbsp;{{ podium.criterion.unit }}{% endif %}</span>
                </li>
            {% endfor %}
        </ol>
    {% else %}
        <p class="mt-4 text-sm text-stone-500">Données bientôt disponibles.</p>
    {% endif %}

    <span class="mt-auto pt-4 text-sm text-emerald-700 transition group-hover:translate-x-1">Voir le classement →</span>
</a>
