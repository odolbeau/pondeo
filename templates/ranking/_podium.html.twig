<a href="{{ path('app_ranking', {code: podium.ranking.code}) }}"
   class="group flex h-full flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-5 transition hover:-translate-y-1 hover:border-emerald-500/50 hover:bg-slate-900">
    <p class="text-xs font-medium uppercase tracking-wider text-emerald-400">{{ podium.ranking.theme }}</p>
    <h3 class="mt-1 text-lg font-semibold text-slate-100">{{ podium.ranking.title }}</h3>
    <p class="mt-1 text-sm text-slate-400">{{ podium.ranking.tagline }}</p>

    {% if podium.rows %}
        <ol class="mt-4 space-y-2 text-sm">
            {% for row in podium.rows %}
                <li class="flex items-baseline gap-3">
                    <span class="w-5 shrink-0 font-semibold text-emerald-400">{{ row.rank }}</span>
                    <span class="min-w-0 flex-1 truncate text-slate-200">{{ row.name }}</span>
                    <span class="shrink-0 tabular-nums text-slate-400">{{ row.value|criterion_value }}{% if podium.criterion.unit %}&nbsp;{{ podium.criterion.unit }}{% endif %}</span>
                </li>
            {% endfor %}
        </ol>
    {% else %}
        <p class="mt-4 text-sm text-slate-500">Données bientôt disponibles.</p>
    {% endif %}

    <span class="mt-auto pt-4 text-sm text-emerald-400 transition group-hover:translate-x-1">Voir le classement →</span>
</a>
