{% extends 'base.html.twig' %}

{% block title %}Classements des unités urbaines — Pondeo{% endblock %}

{% block meta_description %}Les classements des agglomérations de France : démographie, économie, immobilier, qualité de vie, climat, climat en 2050 et risques naturels.{% endblock %}

{% block body %}
<main class="min-h-[calc(100vh-3.5rem)] bg-transparent px-6 py-12 text-stone-900">
    <div class="mx-auto max-w-6xl">
        <h1 class="text-4xl font-bold tracking-tight">Classements</h1>
        <p class="mt-3 max-w-2xl text-stone-600">
            Les agglomérations de France comparées sur les critères où « premier » ou « dernier » veut dire quelque chose.
        </p>

        {% for theme, podiums in themes %}
            <section class="mt-12">
                <h2 class="text-xl font-semibold text-stone-800">{{ theme }}</h2>
                <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {% for podium in podiums %}
                        {{ include('ranking/_podium.html.twig', {podium: podium}) }}
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>
</main>
{% endblock %}
