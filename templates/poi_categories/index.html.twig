{% extends 'base.html.twig' %}

{% block title %}Catégories de POI — Pondeo{% endblock %}

{% block meta_description %}L'arborescence des catégories de points d'intérêt de Pondeo.{% endblock %}

{% block body %}
<main class="min-h-[calc(100vh-3.5rem)] bg-transparent px-6 py-12 text-stone-900">
    <div class="mx-auto max-w-4xl">
        <h1 class="text-4xl font-bold tracking-tight">Catégories de POI</h1>
        <p class="mt-3 max-w-2xl text-stone-600">
            Les catégories de points d'intérêt, groupées par parent : c'est ainsi qu'elles sont regroupées sur la fiche d'une agglomération.
        </p>

        {% macro branch(categories, level) %}
            <ul class="{{ level ? 'mt-1 ml-3 space-y-1 border-l border-stone-200 pl-4 text-sm' : 'mt-8 space-y-4' }}">
                {% for category in categories %}
                    <li>
                        <span class="{{ level ? 'text-stone-800' : 'font-medium text-stone-900' }}">{{ category.label }}</span>
                        <code class="ml-2 text-xs text-stone-500">{{ category.code }}</code>
                        {% if category.children|length %}
                            {{ _self.branch(category.children, level + 1) }}
                        {% endif %}
                    </li>
                {% else %}
                    <li class="text-stone-600">Aucune catégorie.</li>
                {% endfor %}
            </ul>
        {% endmacro %}

        {{ _self.branch(roots, 0) }}
    </div>
</main>
{% endblock %}
