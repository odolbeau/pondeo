{# Says that filters are set, and offers to start over: filled in by the filters controller. #}
<div data-filters-target="summary" hidden class="flex items-center gap-3 text-sm">
    <span data-filters-target="count" class="rounded-full border border-emerald-600 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-800"></span>
    <button type="button" data-action="filters#clear" class="text-xs text-stone-600 underline hover:text-emerald-700">Réinitialiser</button>
</div>
