{# The filters on a page of results, inside a form submitted with the filter: a button opening the panel, and what is
   filtered. With `always_open`, the panel is open from the `lg` breakpoint, for a column beside the results. #}
{% set always_open = always_open ?? false %}
<div data-controller="filters"
     data-filters-population-min-value="{{ populationMin }}"
     data-filters-population-max-value="{{ populationMax }}"
     data-filters-stats-value="{{ stats|json_encode|e('html_attr') }}"
     data-filters-submit-value="true"
     data-filters-keep-value="{{ (keep ?? [])|json_encode|e('html_attr') }}">
    <div class="flex flex-wrap items-center gap-3">
        <button type="button" data-filters-target="toggle" data-action="filters#toggle" aria-expanded="false"
                class="rounded-full border border-stone-300 px-3 py-1 text-sm text-stone-700 hover:border-emerald-600 hover:text-emerald-700{{ always_open ? ' lg:hidden' : '' }}">Filtres</button>
        {{ include('filters/_summary.html.twig') }}
    </div>
    <div data-filters-target="drawer" class="hidden{{ always_open ? ' lg:block lg:max-w-none' : '' }} mt-4 max-w-md rounded-xl border border-stone-200 bg-white p-5">
        {{ include('filters/_panel.html.twig') }}
    </div>
    <div data-filters-target="hidden"></div>
</div>
