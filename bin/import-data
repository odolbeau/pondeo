#!/bin/bash

# Brings the database up to date without dropping anything: migrations, then
# every import (all idempotent upserts). A failed step must fail the script: a
# deployment would otherwise carry on with a half-built database.
set -euo pipefail

CURDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

php "$CURDIR/console" doctrine:database:create --if-not-exists
php "$CURDIR/console" doctrine:migration:migrate -n --no-debug
php "$CURDIR/console" app:import:zones --no-debug
php "$CURDIR/console" app:import:pois:stations --no-debug
php "$CURDIR/console" app:import:pois:stations:journeys --no-debug
php "$CURDIR/console" app:import:pois:nuclear-plants --no-debug
php "$CURDIR/console" app:import:pois:board-games --no-debug
php "$CURDIR/console" app:import:criteria:population --no-debug
php "$CURDIR/console" app:import:criteria:equipements --no-debug
php "$CURDIR/console" app:import:criteria:associations --no-debug
php "$CURDIR/console" app:import:criteria:real-estate-prices --no-debug
php "$CURDIR/console" app:import:criteria:employment --no-debug
php "$CURDIR/console" app:import:criteria:income --no-debug
php "$CURDIR/console" app:import:criteria:education --no-debug
php "$CURDIR/console" app:import:criteria:housing --no-debug
php "$CURDIR/console" app:import:criteria:age-structure --no-debug
php "$CURDIR/console" app:import:criteria:pcs --no-debug
php "$CURDIR/console" app:import:criteria:tax-income --no-debug
php "$CURDIR/console" app:import:criteria:risks --no-debug
php "$CURDIR/console" app:import:criteria:climate --no-debug
php "$CURDIR/console" app:import:criteria:climate-projections --no-debug
php "$CURDIR/console" app:import:age-pyramid --no-debug
php "$CURDIR/console" app:import:station-access --no-debug
