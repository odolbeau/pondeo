#!/bin/bash

# Brings the database up to date without dropping anything: migrations, then
# every import (all idempotent upserts). A failed step must fail the script: a
# deployment would otherwise carry on with a half-built database.
set -euo pipefail

CURDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

php "$CURDIR/console" doctrine:database:create --if-not-exists
php "$CURDIR/console" doctrine:migration:migrate -n --no-debug
php "$CURDIR/console" app:import:zones --no-debug
php "$CURDIR/console" app:import:pois:stations --no-debug
php "$CURDIR/console" app:import:pois:nuclear-plants --no-debug
php "$CURDIR/console" app:import:criteria:population --no-debug
php "$CURDIR/console" app:import:criteria:commerces --no-debug
php "$CURDIR/console" app:import:criteria:real-estate-prices --no-debug
php "$CURDIR/console" app:import:station-access --no-debug
