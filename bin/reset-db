#!/bin/bash

CURDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# The compiled container cache is keyed by env+debug; a container change
# (new service, new constructor arg) that's only ever been warmed under a
# different combination shows up as "service not found"/"too few arguments"
# here otherwise.
php "$CURDIR/console" cache:clear --no-debug

php "$CURDIR/console" doctrine:database:drop --if-exists --force
php "$CURDIR/console" doctrine:database:create --if-not-exists
php "$CURDIR/console" doctrine:migration:migrate -n --no-debug
php "$CURDIR/console" app:zones:import --no-debug
php "$CURDIR/console" app:pois:stations:import --no-debug
php "$CURDIR/console" app:criteria:population:import --no-debug
php "$CURDIR/console" foundry:load-fixtures --no-interaction --append
