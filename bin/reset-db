#!/bin/bash

# A failed step must fail the script.
set -euo pipefail

CURDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# The compiled container cache is keyed by env+debug; a container change
# (new service, new constructor arg) that's only ever been warmed under a
# different combination shows up as "service not found"/"too few arguments"
# here otherwise.
php "$CURDIR/console" cache:clear --no-debug

php "$CURDIR/console" doctrine:database:drop --if-exists --force

"$CURDIR/import-data"
