#!/bin/bash
#
# Starts this worktree's stack on demand and prints its URL. Idempotent:
# only installs dependencies that changed and brings the database up to date
# (migrations, then the imports whose sources changed; a new volume gets
# everything), so it's safe to re-run anytime.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

DEV_PROXY_DIR="${DEV_PROXY_DIR:-$HOME/.local/share/dev-proxy}"

# The compose project is named after the directory (see compose.yaml).
PROJECT="$(docker compose config --format json | python3 -c 'import json,sys; print(json.load(sys.stdin)["name"])')"

if ! docker network inspect dev-proxy >/dev/null 2>&1 \
    || [ -z "$(docker ps --quiet --filter label=com.docker.compose.project=dev-proxy)" ]; then
    echo -e "\033[31mThe dev proxy isn't running (network \`dev-proxy\`).\033[0m" >&2
    echo "It is machine-wide infrastructure, not part of this project: see docs/local-environment.md." >&2
    if [ -n "$(docker ps --quiet --filter publish=443)" ]; then
        echo "Something else owns port 443:" >&2
        docker ps --filter publish=443 --format '  {{.Names}}' >&2
    fi
    exit 1
fi

if [ ! -f "$DEV_PROXY_DIR/certs/pondeo.crt" ]; then
    bin/certs
fi

docker compose up --detach --build --remove-orphans
docker compose run --rm php composer install

# Postgres may still be starting: wait for it, or the update would fail.
until docker compose exec -T database psql -U "${POSTGRES_USER:-app}" -d "${POSTGRES_DB:-app}" -Atc "SELECT 1" >/dev/null 2>&1; do sleep 1; done

make db-update

echo ""
echo -e "\033[32mhttps://${PROJECT}.pondeo.localhost\033[0m"
